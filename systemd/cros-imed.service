[Unit]
Description=ChromeOS IME Daemon
Documentation=https://chromium.googlesource.com/chromiumos/platform2
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/cros-imed
Restart=on-failure
RestartSec=1
Slice=session.slice

[Install]
WantedBy=graphical-session.target
